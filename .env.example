BOT_TOKEN=123456:ABCDEF_your_token_here
ADMIN_ID=123456789

# Mini App (кнопка «Открыть приложение» в боте)
# BOT_WEBAPP_URL=https://calendar.vpncfo.ru
# Локально: SKIP_BOT=1 — не запускать бота (только API), чтобы проверять связь с сервером
# SKIP_BOT=1

# Google Calendar
CALENDAR_ID=your_calendar_id@example.com
GOOGLE_AUTH_MODE=oauth
# OAuth 2.0 (Desktop App)
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=client_secrets.json
GOOGLE_OAUTH_TOKEN_PATH=token.json
#
# Если используешь переменные окружения с JSON (Railway/CI):
# GOOGLE_OAUTH_CLIENT_SECRET_JSON={"installed":{...}}
# GOOGLE_OAUTH_TOKEN_JSON={"access_token": "...", ...}
#
# Legacy Service Account (если нужно временно откатиться)
GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}

# Scheduling
TIMEZONE=Europe/Moscow
WORK_START=11:00
WORK_END=18:00
BUFFER_HOURS=3

# Storage
# Локально: database/smart_scheduler.db. В Docker: volume на /app/data → DB_PATH=/app/data/smart_scheduler.db
DB_PATH=database/smart_scheduler.db

# Logging
LOG_LEVEL=INFO

# Automation
PENDING_TTL_HOURS=24
EXPIRE_CHECK_INTERVAL_SECONDS=60

# DEBUG: отключить проверку Telegram initData (только для диагностики!)
# Включи это ВРЕМЕННО, чтобы проверить, работает ли Mini App без валидации.
# НИКОГДА не оставляй это в проде!
# DISABLE_INIT_DATA_CHECK=1
