BOT_TOKEN=123456:ABCDEF_your_token_here
ADMIN_ID=123456789

# Google Calendar
CALENDAR_ID=your_calendar_id@example.com
GOOGLE_AUTH_MODE=oauth
# OAuth 2.0 (Desktop App)
GOOGLE_OAUTH_CLIENT_SECRETS_PATH=client_secrets.json
GOOGLE_OAUTH_TOKEN_PATH=token.json
#
# Если используешь переменные окружения с JSON (Railway/CI):
# GOOGLE_OAUTH_CLIENT_SECRET_JSON={"installed":{...}}
# GOOGLE_OAUTH_TOKEN_JSON={"access_token": "...", ...}
#
# Legacy Service Account (если нужно временно откатиться)
GOOGLE_CREDENTIALS_PATH=credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account", ...}

# Scheduling
TIMEZONE=Europe/Moscow
WORK_START=11:00
WORK_END=18:00
BUFFER_HOURS=3

# Storage
# Для контейнера в Cloud.ru указывай /app/data/...
DB_PATH=database/smart_scheduler.db

# Logging
LOG_LEVEL=INFO

# Automation
PENDING_TTL_HOURS=24
EXPIRE_CHECK_INTERVAL_SECONDS=60
